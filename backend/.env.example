# PROITBRIDGE backend environment

# Groq (free tier) — get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Resend (email delivery) — optional. If unset, emails are skipped in demo mode.
# Get a key at https://resend.com. Use onboarding@resend.dev as FROM for testing
# (only delivers to your verified Resend account email).
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# --- Future provider switch (uncomment if migrating off Groq) ---
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
